# Database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=kairos
DB_ROOT_PASSWORD=root
DB_USERNAME=kairos_user
DB_PASSWORD=kairos_pass

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=kairos
KEYCLOAK_CLIENT_ID=kairos-api
KEYCLOAK_CLIENT_SECRET=kairos-local-dev-secret
KEYCLOAK_ADMIN_CLIENT_ID=kairos-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=kairos-admin-service-local-dev-only-secret
KEYCLOAK_PUBLIC_HOSTNAME=<your-ec2-public-ip-or-domain>

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_INTERFACE_PORT=15672

# NOTIFICATION
