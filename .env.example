# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kairos
DB_ROOT_PASSWORD=root
DB_USERNAME=kairos_user
DB_PASSWORD=kairos_pass

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=kairos
KEYCLOAK_CLIENT_ID=kairos-api
KEYCLOAK_CLIENT_SECRET=kairos-local-dev-secret


# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_INTERFACE_PORT=15672


# NOTIFICATION
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/myNotificationApiURL